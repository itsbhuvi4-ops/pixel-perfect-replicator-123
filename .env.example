# Server-only secrets
BIDX_FIRST_ADMIN_SETUP_CODE=replace-with-a-long-random-private-code

# Production URL used for password recovery redirects
PUBLIC_SITE_URL=https://auction-delta.lovable.app

# WebRTC TURN configuration — SERVER ONLY (do not prefix with VITE_)
# Preferred: TURN_CREDENTIAL_URL returns short-lived { urls, username, credential } JSON.
TURN_CREDENTIAL_URL=
TURN_CREDENTIAL_API_KEY=
# Fallback static credentials (still delivered only to the browser when used).
TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
